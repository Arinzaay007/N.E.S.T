# Copy to .env.local. Every value is optional for the local demo.
# NEVER commit real secrets.

# Optional prototype data directory. Defaults to .data locally and /tmp/nest-data on Vercel.
NEST_DATA_DIR=

# Secrets used to encrypt demo email-wallet keys and sign sessions.
NEST_ENCRYPTION_KEY=
NEST_SESSION_SECRET=

# Show the email OTP on screen for local demos. Set to false in production.
NEST_DEMO_OTP=true
RESEND_API_KEY=
EMAIL_FROM=[email protected]

# Leave enabled for the judge-runnable prototype; disable before real custody.
NEST_DEMO_FAUCET=true

# NEAR read-only integration. Start on testnet; no keys are read by the web app.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=
NEAR_REGISTRY_CONTRACT_ID=
# Mainnet defaults to the native USDC contract; set explicitly for testnet.
NEAR_USDC_CONTRACT_ID=

# Public addresses used only by local preflight / dry-quote scripts.
NEST_PREFLIGHT_ACCOUNT_ID=
NEST_VERIFY_RECIPIENT_NEAR=
NEST_VERIFY_REFUND_EVM=
NEST_VERIFY_REFUND_SOLANA=
NEST_VERIFY_REFUND_TON=
NEST_VERIFY_AMOUNT_CENTS=100

# NEAR Intents 1Click (mainnet only; dry quotes first, tiny amounts only).
ONE_CLICK_ENABLED=false
ONE_CLICK_API_KEY=
ONE_CLICK_JWT=
# Set false to hard-fail instead of returning a clearly-labelled simulated quote.
ONE_CLICK_FALLBACK=true
